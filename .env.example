# Environment Variables Template
# Copy this file to .env and fill in your values

# ======================
# Application Settings
# ======================

# Production URL (Cloudflare Pages or your domain)
NEXT_PUBLIC_APP_URL=https://your-app-url.pages.dev

# ======================
# Database Configuration
# ======================

# PostgreSQL Connection String (Neon, Supabase, or any PostgreSQL provider)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://username:password@host/database

# ======================
# Authentication
# ======================

# JWT Secret Key (IMPORTANT: Generate a strong random string)
# Generate using: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here-change-this

# ======================
# Telegram Bot (Optional)
# ======================

# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_BOT_USERNAME=YourBotUsername
NEXT_PUBLIC_TELEGRAM_BOT_NAME=YourBotUsername

# Your Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ======================
# Push Notifications
# ======================

# VAPID Keys for Web Push Notifications
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:your-email@example.com

# ======================
# AI Services (Optional)
# ======================

# Google Gemini API (for OCR and image analysis)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API (alternative AI provider)
GROQ_API_KEY=your-groq-api-key-here

# Mistral AI API (alternative AI provider)
MISTRAL_API_KEY=your-mistral-api-key-here

# ======================
# Development Only
# ======================

# For local development, copy this to .dev.vars for Cloudflare Workers
# Cloudflare specific environment variables (optional)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
