    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.13.0",
    "@mistralai/mistralai": "^2.5.0",
    "@neondatabase/serverless": "^1.1.0",
