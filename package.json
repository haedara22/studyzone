{
  "name": "student",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:push": "cd workers/push-worker && wrangler deploy",
    "deploy:all": "npm run deploy:push && wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "secret:set": "wrangler secret put",
    "secret:list": "wrangler secret list",
    "tail": "wrangler tail study-bac-push",
    "android:init": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && .\\gradlew assembleDebug",
    "android:build:release": "cd android && .\\gradlew assembleRelease",
    "android:build:aab": "cd android && .\\gradlew bundleRelease",
    "android:clean": "cd android && .\\gradlew clean"
  },
  "dependencies": {
