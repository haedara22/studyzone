    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "chrome-lens-ocr": "^4.1.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "framer-motion": "^12.42.2",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
